{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/bilda-one/cdn-ish/refs/heads/main/schema/scoop-config.schema.json",
  "title": "Scoop producer configuration",
  "description": "Defines manifest identity, defaults, project overrides, and source-owned hook templates for a Scoop payload producer.",
  "type": "object",
  "required": ["$schema"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URL of this schema.",
      "const": "https://raw.githubusercontent.com/bilda-one/cdn-ish/refs/heads/main/schema/scoop-config.schema.json"
    },
    "reader": {
      "description": "Named bucket reader used to derive project identity from payload files.",
      "allOf": [{ "$ref": "definitions/types.schema.json#/definitions/nonEmptyString" }]
    },
    "defaults": {
      "description": "Manifest values inherited by every project in this producer.",
      "allOf": [{ "$ref": "#/definitions/manifestConfig" }]
    },
    "projects": {
      "type": "object",
      "description": "Overrides keyed by payload project folder name.",
      "additionalProperties": { "$ref": "#/definitions/manifestConfig" }
    }
  },
  "definitions": {
    "nullableString": {
      "anyOf": [
        { "$ref": "definitions/types.schema.json#/definitions/nonEmptyString" },
        { "type": "null" }
      ]
    },
    "suggestValue": {
      "anyOf": [
        { "$ref": "definitions/types.schema.json#/definitions/nonEmptyString" },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "definitions/types.schema.json#/definitions/nonEmptyString" }
        }
      ]
    },
    "manifestConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pre_install": { "$ref": "#/definitions/nullableString" },
        "post_install": { "$ref": "#/definitions/nullableString" },
        "pre_uninstall": { "$ref": "#/definitions/nullableString" },
        "post_uninstall": { "$ref": "#/definitions/nullableString" },
        "installer": { "$ref": "#/definitions/nullableString" },
        "uninstaller": { "$ref": "#/definitions/nullableString" },
        "shortcuts": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": { "$ref": "definitions/types.schema.json#/definitions/nonEmptyString" }
              }
            },
            { "type": "null" }
          ]
        },
        "app": { "$ref": "#/definitions/nullableString" },
        "description": { "$ref": "#/definitions/nullableString" },
        "suggest": {
          "anyOf": [
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "$ref": "#/definitions/suggestValue" }
            },
            { "type": "null" }
          ]
        },
        "license": { "$ref": "#/definitions/nullableString" }
      }
    }
  }
}
